# Template for the compose stack: copy to .env and change the values.
# .env is git-ignored; this file is the only env file in the repository.

# Database created on first start and used by the back-end.
POSTGRES_DB=divenet
POSTGRES_USER=divenet
# Required: compose refuses to start without it.
POSTGRES_PASSWORD=divenet-local

# Required: signs the access tokens. Use a random string of at least 32 bytes,
# for example the output of `openssl rand -base64 32`.
JWT_SECRET=change-me-to-a-random-string-of-32-or-more-bytes

# Optional: the first admin, created at startup when both are set (password: 8+ characters).
ADMIN_EMAIL=admin@divenet.test
ADMIN_PASSWORD=change-me-admin

# Host port of the web server (the SPA and /api).
WEB_PORT=8080
