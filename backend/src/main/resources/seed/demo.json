      "posts": [
        { "title": "Тиждень на Thistlegorm", "text": "Шість занурень на одному кораблі, і щоразу щось нове. На першому оглянули корпус і локомотив на дні. На другому зайшли в трюм №2 з мотоциклами BSA. Нітрокс дуже допоміг: на 30 м часу стало вдвічі більше.\n\nПорада: беріть ліхтар навіть удень, у трюмах темно.", "status": "PUBLISHED", "site": "SS Thistlegorm", "region": null, "photos": 3 },
        { "title": "Дахаб для новачків", "text": "Дахаб — найпростіше місце, щоб почати. Заходите з берега, течії майже немає, риф одразу біля входу. Lighthouse Reef — ідеальний для першого нічного занурення.", "status": "PUBLISHED", "site": null, "region": "eg-dahab", "photos": 1 },
        { "title": "Мальта взимку", "text": "Вода 15 °C, туристів немає, а видимість 30 м. Сухий костюм — і всі печери Гозо ваші.", "status": "PUBLISHED", "site": "Blue Hole Gozo", "region": null, "photos": 2 },
        { "title": "Як я готуюся до глибоких занурень", "text": "Чекліст перед зануренням нижче 30 м: план газу, нітрокс і його межі, резервний ліхтар, SMB, перевірка напарника. Нічого нового, але саме на цьому економлять.", "status": "PUBLISHED", "site": null, "region": null, "photos": 0 },
        { "title": "Одеса: затоплені баржі", "text": "Наше море не тропіки, але затоплені баржі під Одесою — чудовий полігон для навігації та сухих костюмів.", "status": "PUBLISHED", "site": "Odesa Bay Wrecks", "region": null, "photos": 1 },
        { "title": "Чернетка: Ельфінстон", "text": "Південне плато, дві акули…", "status": "DRAFT", "site": "Elphinstone Reef", "region": null, "photos": 0 }
