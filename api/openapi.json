          "schema" : {
            "type" : [ "string", "null" ]
          }
        }, {
          "in" : "query",
          "name" : "qRegion",
          "required" : false,
          "schema" : {
            "items" : {
              "type" : "string"
            },
            "type" : [ "array", "null" ]
          }
        }, {
          "in" : "query",
          "name" : "qCountry",
          "required" : false,
          "schema" : {
            "items" : {
              "type" : "string"
            },
            "type" : [ "array", "null" ]
          }
        }, {
          "in" : "query",
          "name" : "difficulty",
          "required" : false,
          "schema" : {
            "items" : {
              "format" : "int32",
              "type" : "integer"
            },
            "type" : [ "array", "null" ]
          }
        }, {
          "in" : "query",
          "name" : "gear",
          "required" : false,
          "schema" : {
            "items" : {
              "type" : "string"
            },
            "type" : [ "array", "null" ]
          }
        }, {
          "in" : "query",
          "name" : "country",
          "required" : false,
          "schema" : {
            "type" : [ "string", "null" ]
          }
        }, {
          "in" : "query",
          "name" : "region",
          "required" : false,
          "schema" : {
            "type" : [ "string", "null" ]
          }
        }, {
          "in" : "query",
          "name" : "minDepth",
          "required" : false,
          "schema" : {
            "format" : "int32",
            "type" : [ "integer", "null" ]
          }
        }, {
          "in" : "query",
          "name" : "maxDepth",
          "required" : false,
          "schema" : {
            "format" : "int32",
            "type" : [ "integer", "null" ]
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/SiteMarkerResponse"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "site-controller" ]
      }
    },
    "/api/v1/sites/{id}" : {
      "get" : {
        "operationId" : "site",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "int64",
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SiteResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "site-controller" ]
      }
    }
  },
  "servers" : [ {
    "url" : "/"
  } ]
}
