{
  "components" : {
    "schemas" : {
      "AuthResponse" : {
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "expiresIn" : {
            "description" : "Access-token lifetime in seconds",
            "format" : "int64",
            "type" : "integer"
          },
          "tokenType" : {
            "enum" : [ "Bearer" ],
            "type" : "string"
          },
          "user" : {
            "$ref" : "#/components/schemas/UserResponse"
          }
        },
        "required" : [ "accessToken", "expiresIn", "tokenType", "user" ],
        "type" : "object"
      },
      "CountryResponse" : {
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "regions" : {
            "items" : {
              "$ref" : "#/components/schemas/RegionResponse"
            },
            "type" : "array"
          }
        },
        "required" : [ "code", "name", "regions" ],
        "type" : "object"
      },
      "GearItemResponse" : {
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "code", "name" ],
        "type" : "object"
      },
      "LoginRequest" : {
        "properties" : {
          "email" : {
            "minLength" : 1,
            "type" : "string"
          },
          "password" : {
            "minLength" : 1,
            "type" : "string"
          }
        },
        "required" : [ "email", "password" ],
        "type" : "object"
      },
      "RegionResponse" : {
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "code", "name" ],
        "type" : "object"
      },
      "RegisterRequest" : {
        "properties" : {
          "displayName" : {
            "maxLength" : 50,
            "minLength" : 0,
            "type" : "string"
          },
          "email" : {
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0,
            "type" : "string"
          },
          "password" : {
            "maxLength" : 2147483647,
            "minLength" : 8,
            "type" : "string"
          }
        },
        "required" : [ "displayName", "email", "password" ],
        "type" : "object"
      },
      "SiteMarkerResponse" : {
        "properties" : {
          "countryCode" : {
            "type" : "string"
          },
          "difficulty" : {
            "format" : "int32",
            "type" : "integer"
          },
          "id" : {
            "format" : "int64",
            "type" : "integer"
          },
          "lat" : {
            "format" : "double",
            "type" : "number"
          },
          "lng" : {
            "format" : "double",
            "type" : "number"
          },
          "maxDepth" : {
            "format" : "int32",
            "type" : "integer"
          },
          "minDepth" : {
            "format" : "int32",
            "type" : "integer"
          },
          "name" : {
            "type" : "string"
          },
          "regionCode" : {
            "type" : "string"
          }
        },
        "required" : [ "countryCode", "difficulty", "id", "lat", "lng", "maxDepth", "minDepth", "name", "regionCode" ],
        "type" : "object"
      },
      "SiteResponse" : {
        "properties" : {
          "countryCode" : {
            "type" : "string"
          },
          "description" : {
            "type" : "string"
          },
          "difficulty" : {
            "format" : "int32",
            "type" : "integer"
          },
          "id" : {
            "format" : "int64",
            "type" : "integer"
          },
          "lat" : {
            "format" : "double",
            "type" : "number"
          },
          "lng" : {
            "format" : "double",
            "type" : "number"
          },
          "maxDepth" : {
            "format" : "int32",
            "type" : "integer"
          },
          "minDepth" : {
            "format" : "int32",
            "type" : "integer"
          },
          "name" : {
            "type" : "string"
          },
          "recommendedGear" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "regionCode" : {
            "type" : "string"
          },
          "requiredGear" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          }
        },
        "required" : [ "countryCode", "description", "difficulty", "id", "lat", "lng", "maxDepth", "minDepth", "name", "recommendedGear", "regionCode", "requiredGear" ],
        "type" : "object"
      },
      "UserResponse" : {
        "properties" : {
          "displayName" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "id" : {
            "format" : "int64",
            "type" : "integer"
          },
          "role" : {
            "enum" : [ "USER", "ADMIN" ],
            "type" : "string"
          }
        },
        "required" : [ "displayName", "email", "id", "role" ],
        "type" : "object"
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "bearerFormat" : "JWT",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  },
  "info" : {
    "title" : "DiveNet API",
    "version" : "v1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/v1/auth/login" : {
      "post" : {
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "auth-controller" ]
      }
    },
    "/api/v1/auth/logout" : {
      "post" : {
        "operationId" : "logout",
        "parameters" : [ {
          "in" : "cookie",
          "name" : "refresh_token",
          "required" : false,
          "schema" : {
            "type" : [ "string", "null" ]
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        },
        "tags" : [ "auth-controller" ]
      }
    },
    "/api/v1/auth/me" : {
      "get" : {
        "operationId" : "me",
